{
  "name": "mmaf",
  "main": "index.js",
  "compatibility_date": "2026-11-10",
  "durable_objects": {
    "bindings": [
      { "name": "WSS", "class_name": "WebSocketServer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WebSocketServer"] }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}